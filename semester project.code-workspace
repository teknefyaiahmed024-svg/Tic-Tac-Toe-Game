#include<iostream>
#include "raylib.h"

const int screenWidth = 600;
const int screenHeight = 600;
const int cellSize = 200;

// Game board
char board[3][3];

// Player turn
bool playerX = true;

// Function to initialize the board
void InitBoard() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            board[i][j] = ' ';
        }
    }
}

// Function to draw the board
void DrawBoard() {
    // Draw grid
    for (int i = 1; i < 3; i++) {
        DrawLine(i * cellSize, 0, i * cellSize, screenHeight, BLACK);
        DrawLine(0, i * cellSize, screenWidth, i * cellSize, BLACK);
    }

    // Draw marks
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (board[i][j] == 'X') {
                DrawText("X", j * cellSize + cellSize / 2 - 30, i * cellSize + cellSize / 2 - 50, 100, RED);
            } else if (board[i][j] == 'O') {
                DrawText("O", j * cellSize + cellSize / 2 - 30, i * cellSize + cellSize / 2 - 50, 100, BLUE);
            }
        }
    }
}

// Function to check for a winner
char CheckWinner() {
    // Check rows and columns
    for (int i = 0; i < 3; i++) {
        if (board[i][0] == board[i][1] && board[i][1] == board[i][2] && board[i][0] != ' ') return board[i][0];
        if (board[0][i] == board[1][i] && board[1][i] == board[2][i] && board[0][i] != ' ') return board[0][i];
    }

    // Check diagonals
    if (board[0][0] == board[1][1] && board[1][1] == board[2][2] && board[0][0] != ' ') return board[0][0];
    if (board[0][2] == board[1][1] && board[1][1] == board[2][0] && board[0][2] != ' ') return board[0][2];

    // Check for draw or game in progress
    bool draw = true;
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            if (board[i][j] == ' ') {
                draw = false;
                break;
            }
        }
    }
    
    if (draw) return 'D';
    return ' ';
}

int main() {
    InitWindow(screenWidth, screenHeight, "Tic Tac Toe");
    SetTargetFPS(60);

    InitBoard();

    while (!WindowShouldClose()) {
        // Input handling
        if (IsMouseButtonPressed(MOUSE_LEFT_BUTTON)) {
            Vector2 mousePosition = GetMousePosition();
            int row = mousePosition.y / cellSize;
            int col = mousePosition.x / cellSize;

            if (board[row][col] == ' ') {
                board[row][col] = playerX ? 'X' : 'O';
                playerX = !playerX;
            }
        }

        // Check for winner
        char winner = CheckWinner();
        if (winner != ' ') {
            if (winner == 'X') {
                DrawText("Player X Wins!", 150, screenHeight / 2 - 50, 50, RED);
            } else if (winner == 'O') {
                DrawText("Player O Wins!", 150, screenHeight / 2 - 50, 50, BLUE);
            } else if (winner == 'D') {
                DrawText("It's a Draw!", 200, screenHeight / 2 - 50, 50, DARKGRAY);
            }
            EndDrawing();
            break;
        }

        BeginDrawing();
        ClearBackground(PINK);
        DrawBoard();
        EndDrawing();
    }

    CloseWindow();

    return 0;
}